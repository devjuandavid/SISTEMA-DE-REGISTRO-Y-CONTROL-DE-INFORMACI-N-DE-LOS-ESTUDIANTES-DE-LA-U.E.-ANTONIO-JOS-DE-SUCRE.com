<%- include('partials/header') %>
<div class="max-w-md mx-auto bg-white p-8 rounded-lg shadow-lg mt-8 border border-gray-100">
    <!-- Encabezado con barra azul lateral -->
    <div class="flex items-center gap-3 mb-6">
        <div class="w-2 h-8 bg-blue-900 rounded-full"></div>
        <h2 class="text-2xl font-extrabold text-blue-900">U.E. Antonio José de Sucre</h2>
    </div>

    <!-- Logo Oficial -->
    <div class="flex justify-center mb-6">
        <img src="/img/logo.png" alt="Logo U.E. Antonio José de Sucre" class="h-32 object-contain hover:scale-105 transition-transform duration-300">
    </div>

    <% if (error) { %>
        <div class="bg-red-100 border-l-4 border-red-500 text-red-700 p-3 rounded mb-4 text-sm">
            <%= error %>
        </div>
    <% } %>

    <form action="/auth/login" method="POST" class="space-y-4">
        <div>
            <label class="block text-gray-700 font-semibold mb-1 text-sm">Usuario</label>
            <input type="text" name="usuario" required class="w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-900 focus:border-transparent transition">
        </div>
        <div>
            <label class="block text-gray-700 font-semibold mb-1 text-sm">Contraseña</label>
            <input type="password" name="password" required class="w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-900 focus:border-transparent transition">
        </div>
        <button type="submit" class="w-full bg-blue-900 text-white py-2.5 rounded font-bold hover:bg-blue-800 transition shadow">Ingresar al Sistema</button>
    </form>
</div>
<%- include('partials/footer') %>
<%- include('../partials/header') %>

<div class="bg-white p-6 rounded-lg shadow-md mb-6">
    <div class="flex justify-between items-center mb-6">
        <h2 class="text-2xl font-bold text-gray-800"><i class="fas fa-user-graduate text-blue-600 mr-2"></i> Gestión de Estudiantes (RUDE)</h2>
        <button onclick="document.getElementById('modalNuevo').classList.remove('hidden')" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded transition">
            <i class="fas fa-user-plus mr-2"></i> Nuevo Estudiante
        </button>
    </div>

    <!-- Tabla -->
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse border border-gray-200">
            <thead>
                <tr class="bg-gray-800 text-white text-xs uppercase">
                    <th class="p-3 border">RUDE</th>
                    <th class="p-3 border">CI</th>
                    <th class="p-3 border">Apellidos y Nombres</th>
                    <th class="p-3 border text-center">GÉNERO</th>
                    <th class="p-3 border">Curso</th>
                    <th class="p-3 border text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                <% estudiantes.forEach(e => { %>
                    <tr class="border-b hover:bg-gray-50 text-sm">
                        <td class="p-3 border font-mono"><%= e.rude %></td>
                        <td class="p-3 border"><%= e.ci %></td>
                        <td class="p-3 border font-semibold"><%= e.apellidos %> <%= e.nombres %></td>
                        <td class="p-3 border text-center"><%= e.genero %></td>
                        <td class="p-3 border"><%= e.curso_nombre || 'Sin Asignar' %></td>
                        <td class="p-3 border text-center space-x-2">
                            <a href="/estudiantes/eliminar/<%= e.id %>" onclick="return confirm('¿Seguro de eliminar este estudiante?')" class="bg-red-600 hover:bg-red-700 text-white px-3 py-1 rounded text-xs">
                                <i class="fas fa-trash"></i> Eliminar
                            </a>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Registrar Estudiante -->
<div id="modalNuevo" class="hidden fixed inset-0 bg-gray-900 bg-opacity-50 flex justify-center items-center">
    <div class="bg-white p-6 rounded-lg w-full max-w-lg shadow-xl">
        <h3 class="text-xl font-bold mb-4">Registrar Nuevo Estudiante</h3>
        <form action="/estudiantes/nuevo" method="POST" class="space-y-3">
            <div>
                <label class="block text-xs font-bold">RUDE:</label>
                <input type="text" name="rude" class="w-full border p-2 rounded" required>
            </div>
            <div>
                <label class="block text-xs font-bold">CI:</label>
                <input type="text" name="ci" class="w-full border p-2 rounded">
            </div>
            <div class="grid grid-cols-2 gap-2">
                <div>
                    <label class="block text-xs font-bold">Apellidos:</label>
                    <input type="text" name="apellidos" class="w-full border p-2 rounded" required>
                </div>
                <div>
                    <label class="block text-xs font-bold">Nombres:</label>
                    <input type="text" name="nombres" class="w-full border p-2 rounded" required>
                </div>
            </div>
            <div class="grid grid-cols-2 gap-2">
                <div>
                    <label class="block text-xs font-bold">Género:</label>
                    <select name="genero" class="w-full border p-2 rounded">
                        <option value="M">Masculino (M)</option>
                        <option value="F">Femenino (F)</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold">Curso:</label>
                    <select name="curso_id" class="w-full border p-2 rounded">
                        <option value="">-- Asignar Curso --</option>
                        <% cursos.forEach(c => { %>
                            <option value="<%= c.id %>"><%= c.grado %> <%= c.paralelo %></option>
                        <% }) %>
                    </select>
                </div>
            </div>
            <div class="flex justify-end space-x-2 pt-4">
                <button type="button" onclick="document.getElementById('modalNuevo').classList.add('hidden')" class="bg-gray-500 text-white px-4 py-2 rounded">Cancelar</button>
                <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded font-bold">Guardar</button>
            </div>
        </form>
    </div>
</div>

<%- include('../partials/footer') %>
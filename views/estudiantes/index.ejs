<%- include('partials/header') %>

<div class="bg-white p-6 rounded-lg shadow-md">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-xl font-bold text-gray-800">Lista de Estudiantes (RUDE)</h1>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full text-sm text-left text-gray-600">
            <thead class="text-xs text-gray-700 uppercase bg-gray-100">
                <tr>
                    <th class="py-3 px-4">RUDE</th>
                    <th class="py-3 px-4">CI</th>
                    <th class="py-3 px-4">Apellidos y Nombres</th>
                    <th class="py-3 px-4">Género</th>
                    <th class="py-3 px-4">Curso</th>
                </tr>
            </thead>
            <tbody>
                <% if (estudiantes && estudiantes.length > 0) { %>
                    <% estudiantes.forEach(e => { %>
                        <tr class="border-b hover:bg-gray-50">
                            <td class="py-3 px-4"><%= e.rude || 'S/R' %></td>
                            <td class="py-3 px-4"><%= e.ci || 'S/C' %></td>
                            <td class="py-3 px-4 font-semibold"><%= e.apellidos %> <%= e.nombres %></td>
                            <td class="py-3 px-4"><%= e.genero %></td>
                            <td class="py-3 px-4"><%= e.curso_nombre || 'Sin Asignar' %></td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="5" class="py-4 text-center text-gray-500">No hay estudiantes registrados.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<%- include('partials/footer') %>
<%- include('../partials/header') %>

<div class="bg-white p-6 rounded-lg shadow-md mb-6">
    <h2 class="text-2xl font-bold text-gray-800 mb-4"><i class="fas fa-calendar-check text-blue-600 mr-2"></i> Control Diario de Asistencia</h2>

    <form method="GET" action="/asistencia" class="grid grid-cols-1 md:grid-cols-4 gap-4 bg-gray-50 p-4 rounded border mb-6">
        <div>
            <label class="block text-xs font-bold mb-1">Curso:</label>
            <select name="curso_id" onchange="this.form.submit()" class="w-full border p-2 rounded text-xs" required>
                <option value="">-- Seleccionar --</option>
                <% cursos.forEach(c => { %>
                    <option value="<%= c.id %>" <%= curso_id == c.id ? 'selected' : '' %>><%= c.grado %> <%= c.paralelo %></option>
                <% }) %>
            </select>
        </div>
        <div>
            <label class="block text-xs font-bold mb-1">Materia:</label>
            <select name="materia_id" class="w-full border p-2 rounded text-xs" required>
                <option value="">-- Seleccionar --</option>
                <% materias.forEach(m => { %>
                    <option value="<%= m.id %>" <%= materia_id == m.id ? 'selected' : '' %>><%= m.nombre %></option>
                <% }) %>
            </select>
        </div>
        <div>
            <label class="block text-xs font-bold mb-1">Fecha:</label>
            <input type="date" name="fecha" value="<%= fecha || '' %>" class="w-full border p-2 rounded text-xs" required>
        </div>
        <div class="flex items-end">
            <button type="submit" class="w-full bg-blue-600 text-white font-bold py-2 rounded text-xs">Cargar Lista</button>
        </div>
    </form>

    <% if (estudiantes.length > 0) { %>
        <form action="/asistencia/guardar" method="POST">
            <input type="hidden" name="curso_id" value="<%= curso_id %>">
            <input type="hidden" name="materia_id" value="<%= materia_id %>">
            <input type="hidden" name="fecha" value="<%= fecha %>">

            <table class="w-full text-left border-collapse border border-gray-200 text-xs">
                <thead>
                    <tr class="bg-gray-800 text-white uppercase">
                        <th class="p-3 border">Estudiante</th>
                        <th class="p-3 border text-center">Estado de Asistencia</th>
                    </tr>
                </thead>
                <tbody>
                    <% estudiantes.forEach(e => { %>
                        <tr class="border-b hover:bg-gray-50">
                            <td class="p-3 border font-bold"><%= e.apellidos %> <%= e.nombres %></td>
                            <td class="p-3 border text-center">
                                <select name="asistencia[<%= e.id %>]" class="border p-1 rounded font-bold text-xs">
                                    <option value="PRESENTE" <%= e.estado === 'PRESENTE' ? 'selected' : '' %>>PRESENTE</option>
                                    <option value="FALTA" <%= e.estado === 'FALTA' ? 'selected' : '' %>>FALTA</option>
                                    <option value="LICENCIA" <%= e.estado === 'LICENCIA' ? 'selected' : '' %>>LICENCIA</option>
                                    <option value="ATRASO" <%= e.estado === 'ATRASO' ? 'selected' : '' %>>ATRASO</option>
                                </select>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>

            <div class="mt-4 flex justify-end">
                <button type="submit" class="bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-6 rounded">Guardar Asistencia</button>
            </div>
        </form>
    <% } %>
</div>

<%- include('../partials/footer') %>
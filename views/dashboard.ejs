<%- include('partials/header') %>

<div class="space-y-6">
    <div class="bg-blue-900 text-white p-6 rounded-lg shadow-md flex justify-between items-center">
        <div>
            <h1 class="text-2xl font-bold">Bienvenido, <%= user ? user.nombre_completo : 'Usuario' %></h1>
            <p class="text-sm text-blue-200 mt-1">Rol: <span class="uppercase font-semibold"><%= user ? user.rol : 'Sin rol' %></span></p>
        </div>
        <div class="text-right">
            <span class="text-xs bg-blue-800 px-3 py-1 rounded-full border border-blue-700">Sistema Escolar SIE</span>
        </div>
    </div>

    <!-- Tarjetas de Estadísticas -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200 flex items-center justify-between">
            <div>
                <p class="text-xs font-bold text-gray-500 uppercase">Estudiantes Registrados</p>
                <p class="text-3xl font-extrabold text-blue-900 mt-1"><%= totales.estudiantes %></p>
            </div>
            <div class="bg-blue-100 p-3 rounded-full text-blue-900">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
            </div>
        </div>

        <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200 flex items-center justify-between">
            <div>
                <p class="text-xs font-bold text-gray-500 uppercase">Cursos Habilitados</p>
                <p class="text-3xl font-extrabold text-green-700 mt-1"><%= totales.cursos %></p>
            </div>
            <div class="bg-green-100 p-3 rounded-full text-green-700">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
            </div>
        </div>

        <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200 flex items-center justify-between">
            <div>
                <p class="text-xs font-bold text-gray-500 uppercase">Materias Asignadas</p>
                <p class="text-3xl font-extrabold text-purple-700 mt-1"><%= totales.materias %></p>
            </div>
            <div class="bg-purple-100 p-3 rounded-full text-purple-700">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
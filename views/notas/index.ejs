<%- include('../partials/header') %>

<div class="space-y-4">
    <div class="bg-white p-4 rounded-lg shadow border">
        <form method="GET" action="/notas" class="grid grid-cols-1 md:grid-cols-4 gap-4 items-end">
            <div>
                <label class="block text-xs font-bold text-gray-700">Curso</label>
                <select name="curso_id" required class="w-full border p-2 rounded text-sm">
                    <option value="">Seleccionar Curso</option>
                    <% cursos.forEach(c => { %>
                        <option value="<%= c.id %>" <%= curso_id == c.id ? 'selected' : '' %>><%= c.grado %> <%= c.paralelo %> (<%= c.turno %>)</option>
                    <% }) %>
                </select>
            </div>
            <div>
                <label class="block text-xs font-bold text-gray-700">Materia</label>
                <select name="materia_id" required class="w-full border p-2 rounded text-sm">
                    <option value="">Seleccionar Materia</option>
                    <% materias.forEach(m => { %>
                        <option value="<%= m.id %>" <%= materia_id == m.id ? 'selected' : '' %>><%= m.nombre %></option>
                    <% }) %>
                </select>
            </div>
            <div>
                <label class="block text-xs font-bold text-gray-700">Trimestre</label>
                <select name="trimestre" required class="w-full border p-2 rounded text-sm">
                    <option value="1" <%= trimestre == '1' ? 'selected' : '' %>>Primer Trimestre</option>
                    <option value="2" <%= trimestre == '2' ? 'selected' : '' %>>Segundo Trimestre</option>
                    <option value="3" <%= trimestre == '3' ? 'selected' : '' %>>Tercer Trimestre</option>
                </select>
            </div>
            <button type="submit" class="bg-blue-900 text-white font-bold p-2 rounded text-sm hover:bg-blue-800">Cargar Planilla</button>
        </form>
    </div>

    <% if (planilla.length > 0) { %>
    <form action="/notas/guardar" method="POST" class="bg-white p-4 rounded-lg shadow border overflow-x-auto">
        <input type="hidden" name="curso_id" value="<%= curso_id %>">
        <input type="hidden" name="materia_id" value="<%= materia_id %>">
        <input type="hidden" name="trimestre" value="<%= trimestre %>">

        <table class="w-full text-xs text-center border-collapse border border-gray-300">
            <thead>
                <tr class="bg-gray-200">
                    <th rowspan="2" class="border p-1">Nº</th>
                    <th rowspan="2" class="border p-1 text-left">Apellidos y Nombres</th>
                    <th colspan="4" class="border p-1 bg-yellow-100">Asistencia</th>
                    <th class="border p-1 bg-green-100">SER (10)</th>
                    <th class="border p-1 bg-blue-100">SABER (45)</th>
                    <th class="border p-1 bg-orange-100">HACER (40)</th>
                    <th class="border p-1 bg-purple-100">AUTOEVAL. (5)</th>
                    <th rowspan="2" class="border p-1 bg-gray-300 font-bold">NOTA TRIM.</th>
                    <th rowspan="2" class="border p-1">Apreciación Cualitativa</th>
                </tr>
                <tr class="bg-gray-100">
                    <th class="border p-1">A</th><th class="border p-1">F</th><th class="border p-1">R</th><th class="border p-1">L</th>
                    <th class="border p-1">Nota</th><th class="border p-1">Nota</th><th class="border p-1">Nota</th><th class="border p-1">Nota</th>
                </tr>
            </thead>
            <tbody>
                <% planilla.forEach((p, idx) => { %>
                    <tr class="hover:bg-gray-50">
                        <td class="border p-1"><%= idx + 1 %></td>
                        <td class="border p-1 text-left font-bold"><%= p.apellidos %> <%= p.nombres %></td>
                        <td class="border p-1 text-green-700 font-bold"><%= p.asistencia %></td>
                        <td class="border p-1 text-red-600 font-bold"><%= p.faltas %></td>
                        <td class="border p-1 text-yellow-600 font-bold"><%= p.retrasos %></td>
                        <td class="border p-1 text-blue-600 font-bold"><%= p.licencias %></td>
                        
                        <td class="border p-1"><input type="number" step="0.1" max="10" name="notas[<%= p.estudiante_id %>][ser]" value="<%= p.ser %>" class="w-12 text-center border rounded"></td>
                        <td class="border p-1"><input type="number" step="0.1" max="45" name="notas[<%= p.estudiante_id %>][saber]" value="<%= p.saber %>" class="w-12 text-center border rounded"></td>
                        <td class="border p-1"><input type="number" step="0.1" max="40" name="notas[<%= p.estudiante_id %>][hacer]" value="<%= p.hacer %>" class="w-12 text-center border rounded"></td>
                        <td class="border p-1"><input type="number" step="0.1" max="5" name="notas[<%= p.estudiante_id %>][autoevaluacion]" value="<%= p.autoevaluacion %>" class="w-12 text-center border rounded"></td>
                        
                        <td class="border p-1 font-bold text-sm bg-gray-100"><%= p.nota_trimestral %></td>
                        <td class="border p-1"><input type="text" name="notas[<%= p.estudiante_id %>][cualitativo]" value="<%= p.cualitativo %>" class="w-full border px-1 rounded"></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>

        <div class="mt-4 flex justify-end">
            <button type="submit" class="bg-green-700 text-white font-bold px-6 py-2 rounded text-sm hover:bg-green-600">Guardar Calificaciones</button>
        </div>
    </form>
    <% } %>
</div>

<%- include('../partials/footer') %>
<%- include('../partials/header') %>

<div class="bg-white p-6 rounded-lg shadow-md mb-6">
    <h2 class="text-2xl font-bold text-gray-800 mb-4"><i class="fas fa-calculator text-blue-600 mr-2"></i> Centralizador de Notas (Ley 070)</h2>

    <form method="GET" action="/notas" class="grid grid-cols-1 md:grid-cols-4 gap-4 bg-gray-50 p-4 rounded border mb-6">
        <div>
            <label class="block text-xs font-bold mb-1">Curso:</label>
            <select name="curso_id" onchange="this.form.submit()" class="w-full border p-2 rounded text-xs" required>
                <option value="">-- Seleccionar --</option>
                <% cursos.forEach(c => { %>
                    <option value="<%= c.id %>" <%= curso_id == c.id ? 'selected' : '' %>><%= c.grado %> <%= c.paralelo %></option>
                <% }) %>
            </select>
        </div>

        <div>
            <label class="block text-xs font-bold mb-1">Materia:</label>
            <select name="materia_id" class="w-full border p-2 rounded text-xs" required>
                <option value="">-- Seleccionar --</option>
                <% materias.forEach(m => { %>
                    <option value="<%= m.id %>" <%= materia_id == m.id ? 'selected' : '' %>><%= m.nombre %></option>
                <% }) %>
            </select>
        </div>

        <div>
            <label class="block text-xs font-bold mb-1">Trimestre:</label>
            <select name="trimestre" class="w-full border p-2 rounded text-xs" required>
                <option value="1" <%= trimestre == 1 ? 'selected' : '' %>>1er Trimestre</option>
                <option value="2" <%= trimestre == 2 ? 'selected' : '' %>>2do Trimestre</option>
                <option value="3" <%= trimestre == 3 ? 'selected' : '' %>>3er Trimestre</option>
            </select>
        </div>

        <div class="flex items-end">
            <button type="submit" class="w-full bg-blue-600 text-white font-bold py-2 rounded text-xs">Cargar Planilla</button>
        </div>
    </form>

    <% if (estudiantes.length > 0) { %>
        <form action="/notas/guardar" method="POST">
            <input type="hidden" name="curso_id" value="<%= curso_id %>">
            <input type="hidden" name="materia_id" value="<%= materia_id %>">
            <input type="hidden" name="trimestre" value="<%= trimestre %>">

            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse border border-gray-200 text-xs">
                    <thead>
                        <tr class="bg-gray-800 text-white text-center font-bold">
                            <th class="p-2 border">Estudiante</th>
                            <th class="p-2 border w-20">Saber (35)</th>
                            <th class="p-2 border w-20">Hacer (35)</th>
                            <th class="p-2 border w-20">Ser (10)</th>
                            <th class="p-2 border w-20">Decidir (10)</th>
                            <th class="p-2 border w-20">Auto (10)</th>
                            <th class="p-2 border w-24">Nota Final (100)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% estudiantes.forEach(e => { %>
                            <tr class="border-b hover:bg-gray-50">
                                <td class="p-2 border font-bold"><%= e.apellidos %> <%= e.nombres %></td>
                                <td class="p-2 border text-center"><input type="number" step="0.1" max="35" min="0" name="notas[<%= e.id %>][saber]" value="<%= e.saber %>" class="w-full border text-center p-1 rounded"></td>
                                <td class="p-2 border text-center"><input type="number" step="0.1" max="35" min="0" name="notas[<%= e.id %>][hacer]" value="<%= e.hacer %>" class="w-full border text-center p-1 rounded"></td>
                                <td class="p-2 border text-center"><input type="number" step="0.1" max="10" min="0" name="notas[<%= e.id %>][ser]" value="<%= e.ser %>" class="w-full border text-center p-1 rounded"></td>
                                <td class="p-2 border text-center"><input type="number" step="0.1" max="10" min="0" name="notas[<%= e.id %>][decidir]" value="<%= e.decidir %>" class="w-full border text-center p-1 rounded"></td>
                                <td class="p-2 border text-center"><input type="number" step="0.1" max="10" min="0" name="notas[<%= e.id %>][autoevaluacion]" value="<%= e.autoevaluacion %>" class="w-full border text-center p-1 rounded"></td>
                                <td class="p-2 border text-center font-bold text-lg <%= e.nota_final >= 51 ? 'text-green-600' : 'text-red-600' %>"><%= e.nota_final %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>

            <div class="mt-4 flex justify-end">
                <button type="submit" class="bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-6 rounded">Guardar Calificaciones</button>
            </div>
        </form>
    <% } %>
</div>

<%- include('../partials/footer') %>
<%- include('../partials/header') %>

<div class="space-y-6">
    <div class="flex items-center gap-3">
        <div class="w-2 h-8 bg-blue-900 rounded-full"></div>
        <h1 class="text-2xl font-bold text-blue-900">Configuración del Sistema</h1>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Registrar Cursos -->
        <div class="bg-white p-6 rounded-lg shadow-md border">
            <h2 class="text-lg font-bold text-gray-800 mb-4">Gestión de Cursos y Turnos</h2>
            <form action="/configuracion/cursos" method="POST" class="space-y-3">
                <div>
                    <label class="block text-xs font-bold text-gray-600">Nivel</label>
                    <select name="nivel" class="w-full border p-2 rounded text-sm">
                        <option value="Inicial en Familia Comunitaria">Inicial en Familia Comunitaria</option>
                        <option value="Primaria Comunitaria Vocacional">Primaria Comunitaria Vocacional</option>
                        <option value="Secundaria Comunitaria Productiva">Secundaria Comunitaria Productiva</option>
                    </select>
                </div>
                <div class="grid grid-cols-3 gap-2">
                    <div>
                        <label class="block text-xs font-bold text-gray-600">Grado</label>
                        <input type="text" name="grado" placeholder="Ej: Primero" required class="w-full border p-2 rounded text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-600">Paralelo</label>
                        <input type="text" name="paralelo" placeholder="Ej: A" required class="w-full border p-2 rounded text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-600">Turno</label>
                        <select name="turno" class="w-full border p-2 rounded text-sm">
                            <option value="MAÑANA">MAÑANA</option>
                            <option value="TARDE">TARDE</option>
                        </select>
                    </div>
                </div>
                <button type="submit" class="w-full bg-blue-900 text-white font-bold py-2 rounded text-sm hover:bg-blue-800">Guardar Curso</button>
            </form>

            <div class="mt-4 max-h-40 overflow-y-auto">
                <table class="w-full text-xs text-left border">
                    <thead class="bg-gray-100">
                        <tr><th class="p-1 border">Grado</th><th class="p-1 border">Paralelo</th><th class="p-1 border">Turno</th></tr>
                    </thead>
                    <tbody>
                        <% cursos.forEach(c => { %>
                            <tr><td class="p-1 border"><%= c.grado %></td><td class="p-1 border"><%= c.paralelo %></td><td class="p-1 border"><%= c.turno %></td></tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Registrar Materias -->
        <div class="bg-white p-6 rounded-lg shadow-md border">
            <h2 class="text-lg font-bold text-gray-800 mb-4">Gestión de Áreas / Materias</h2>
            <form action="/configuracion/materias" method="POST" class="space-y-3">
                <div>
                    <label class="block text-xs font-bold text-gray-600">Área de Saberes</label>
                    <input type="text" name="area" placeholder="Ej: MATEMÁTICA / COMUNICACIÓN" required class="w-full border p-2 rounded text-sm">
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-600">Nombre de la Materia</label>
                    <input type="text" name="nombre" placeholder="Ej: Matemática" required class="w-full border p-2 rounded text-sm">
                </div>
                <button type="submit" class="w-full bg-green-700 text-white font-bold py-2 rounded text-sm hover:bg-green-600">Guardar Materia</button>
            </form>

            <div class="mt-4 max-h-40 overflow-y-auto">
                <table class="w-full text-xs text-left border">
                    <thead class="bg-gray-100">
                        <tr><th class="p-1 border">Materia</th><th class="p-1 border">Área</th></tr>
                    </thead>
                    <tbody>
                        <% materias.forEach(m => { %>
                            <tr><td class="p-1 border"><%= m.nombre %></td><td class="p-1 border"><%= m.area %></td></tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
<%- include('../partials/header') %>

<div class="bg-white p-6 rounded-lg shadow-md mb-6">
    <div class="flex justify-between items-center mb-6">
        <h2 class="text-2xl font-bold text-gray-800"><i class="fas fa-school text-blue-600 mr-2"></i> Gestión de Cursos</h2>
        <% if (usuario && usuario.rol === 'ADMIN') { %>
            <button onclick="document.getElementById('modalCurso').classList.remove('hidden')" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded text-xs">
                <i class="fas fa-plus mr-2"></i> Nuevo Curso
            </button>
        <% } %>
    </div>

    <table class="w-full text-left border-collapse border border-gray-200 text-xs">
        <thead>
            <tr class="bg-gray-800 text-white uppercase">
                <th class="p-3 border">Grado</th>
                <th class="p-3 border text-center">Paralelo</th>
                <th class="p-3 border">Nivel</th>
                <% if (usuario && usuario.rol === 'ADMIN') { %>
                    <th class="p-3 border text-center">Acciones</th>
                <% } %>
            </tr>
        </thead>
        <tbody>
            <% cursos.forEach(c => { %>
                <tr class="border-b hover:bg-gray-50">
                    <td class="p-3 border font-bold"><%= c.grado %></td>
                    <td class="p-3 border text-center font-bold text-blue-800"><%= c.paralelo %></td>
                    <td class="p-3 border"><%= c.nivel %></td>
                    <% if (usuario && usuario.rol === 'ADMIN') { %>
                        <td class="p-3 border text-center">
                            <a href="/cursos/eliminar/<%= c.id %>" onclick="return confirm('¿Eliminar curso?')" class="text-red-600 hover:text-red-800"><i class="fas fa-trash"></i></a>
                        </td>
                    <% } %>
                </tr>
            <% }) %>
        </tbody>
    </table>
</div>

<!-- Modal Registrar Curso -->
<div id="modalCurso" class="hidden fixed inset-0 bg-gray-900 bg-opacity-50 flex justify-center items-center z-50">
    <div class="bg-white p-6 rounded-lg w-full max-w-md shadow-xl">
        <h3 class="text-lg font-bold mb-4 border-b pb-2">Registrar Nuevo Curso</h3>
        <form action="/cursos/nuevo" method="POST" class="space-y-4 text-xs">
            <div>
                <label class="block font-bold">Grado:</label>
                <input type="text" name="grado" placeholder="Ej: 1ro, 2do, 3ro..." required class="w-full border p-2 rounded">
            </div>
            <div>
                <label class="block font-bold">Paralelo:</label>
                <input type="text" name="paralelo" placeholder="Ej: A, B, C..." required class="w-full border p-2 rounded">
            </div>
            <div>
                <label class="block font-bold">Nivel Educational:</label>
                <select name="nivel" class="w-full border p-2 rounded">
                    <option value="Primaria Comunitaria Vocacional">Primaria</option>
                    <option value="Secundaria Productiva">Secundaria</option>
                </select>
            </div>
            <div class="flex justify-end gap-2 pt-4 border-t">
                <button type="button" onclick="document.getElementById('modalCurso').classList.add('hidden')" class="bg-gray-500 text-white px-4 py-2 rounded">Cancelar</button>
                <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded font-bold">Guardar Curso</button>
            </div>
        </form>
    </div>
</div>

<%- include('../partials/footer') %>